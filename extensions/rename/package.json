{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "rename",
  "title": "Rename Files with AI",
  "description": "Rename files with AI-generated suggestions",
  "keywords": [
    "rename",
    "files",
    "folders",
    "ai",
    "suggestions"
  ],
  "icon": "rename-icon.png",
  "author": "omarshahine",
  "categories": [
    "Productivity"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "rename",
      "title": "Rename Files",
      "subtitle": "Rename files and folders with AI-generated suggestions",
      "icon": "rename.png",
      "description": "Rename files with AI-generated suggestions",
      "mode": "view"
    },
    {
      "name": "managePresets",
      "title": "Manage Presets",
      "subtitle": "Create and manage your renaming presets",
      "icon": "manage-presets.png",
      "description": "Create and manage your renaming presets",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "apiKey",
      "title": "OpenAI API Key",
      "description": "Your OpenAI API key",
      "type": "password",
      "required": true
    },
    {
      "name": "model",
      "title": "OpenAI Model",
      "description": "Select which OpenAI model to use",
      "type": "dropdown",
      "required": true,
      "default": "gpt-5.2",
      "data": [
        {
          "title": "GPT-5.2",
          "value": "gpt-5.2"
        },
        {
          "title": "GPT-5.2 Mini",
          "value": "gpt-5.2-mini"
        },
        {
          "title": "GPT-4.1",
          "value": "gpt-4.1"
        }
      ]
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.103.0",
    "@raycast/utils": "^1.14.0",
    "axios": "^1.6.7",
    "fs-extra": "^11.3.0",
    "image-size": "^2.0.1",
    "mammoth": "^1.9.0",
    "officegen": "^0.6.5",
    "openai": "^6.10.0",
    "textract": "^2.5.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@raycast/eslint-config": "1.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "eslint": "^8.56.0",
    "prettier": "^3.2.5",
    "react-devtools": "^6.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  }
}
